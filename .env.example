CONTINUUM_DATABASE_URL=postgres://continuum:continuum@localhost:5433/continuum
CONTINUUM_DB_POOL_MAX=10
CONTINUUM_DB_IDLE_TIMEOUT_MS=10000
CONTINUUM_DB_CONNECTION_TIMEOUT_MS=5000
CONTINUUM_API_PORT=4000
CONTINUUM_LOG_LEVEL=info
CONTINUUM_LIFECYCLE_BATCH_SIZE=100
CONTINUUM_REVIEW_HORIZON_DAYS=14

CONTINUUM_EMBEDDING_PROVIDER=ollama
CONTINUUM_EMBEDDING_MODEL=nomic-embed-text
# v0 storage uses vector(768); other dimensions are rejected at startup.
CONTINUUM_EMBEDDING_DIM=768
CONTINUUM_OLLAMA_URL=http://localhost:11434
# Positive integer milliseconds, maximum 300000. Applies to each provider HTTP call.
CONTINUUM_EMBEDDING_TIMEOUT_MS=10000
# Inclusive cosine-similarity threshold for write-time relation candidates.
CONTINUUM_RELATION_THRESHOLD=0.92

# Optional canonical multi-provider routing. When set, this replaces the
# legacy single-provider variables above. Keep API keys in OPENAI_API_KEY and
# VOYAGE_API_KEY, never in this JSON value.
# CONTINUUM_EMBEDDING_CONFIG={"providers":[{"alias":"local","kind":"ollama","model":"nomic-embed-text","dim":768,"endpoint":"http://localhost:11434","local":true},{"alias":"hosted","kind":"openai","model":"text-embedding-3-small","dim":768,"local":false}],"routing":{"default":"hosted","rules":[{"match":{"kind":"user"},"provider":"local-only"},{"match":{"kind":"org"},"provider":"local-only"}]}}
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Bounded zero-hit knowledge-gap insights.
CONTINUUM_GAPS_SIMILARITY_THRESHOLD=0.85
CONTINUUM_GAPS_CANDIDATE_LIMIT=500
CONTINUUM_GAPS_SCAN_LIMIT=5000
CONTINUUM_GAPS_MAX_QUERY_CHARS=2000
CONTINUUM_GAPS_DEFAULT_RESULTS=20
CONTINUUM_GAPS_MAX_RESULTS=100
CONTINUUM_GAPS_MIN_FREQUENCY=1
CONTINUUM_GAPS_EMBED_TIMEOUT_MS=2000

CONTINUUM_ENTRA_TENANT_ID=
CONTINUUM_ENTRA_CLIENT_ID=
CONTINUUM_ENTRA_CLIENT_SECRET=
