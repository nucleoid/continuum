# Non-secret inputs only. Replace every empty value after artifact verification.
# Linux amd64 only; image values must be tested sha256 image IDs or repo@sha256.
COMPOSE_PROJECT_NAME=
CONTINUUM_APP_IMAGE=
CONTINUUM_POSTGRES_IMAGE=
CONTINUUM_RUNTIME_ASSETS=
CONTINUUM_PGDATA_VOLUME=
CONTINUUM_DATABASE=continuum
CONTINUUM_APPLICATION_SCHEMA=continuum
CONTINUUM_PROVIDER_SCHEMA=continuum_vector
CONTINUUM_DBA_ROLE=continuum_dba
CONTINUUM_OWNER_ROLE=continuum_owner
CONTINUUM_APP_ROLE=continuum_app
CONTINUUM_OPERATOR_ROLE=continuum_operator
CONTINUUM_SYNC_ROLE=continuum_sync
# Absolute host files readable by their mounted container UID; no passwords here.
CONTINUUM_DBA_PASSWORD_FILE=
CONTINUUM_OWNER_PASSWORD_FILE=
CONTINUUM_APP_PASSWORD_FILE=
CONTINUUM_OPERATOR_PASSWORD_FILE=
CONTINUUM_SYNC_PASSWORD_FILE=
# URLs must use postgres:5432 and options=-csearch_path%3Dcontinuum.
# Encode reserved password characters; APP and owner URLs name distinct roles.
CONTINUUM_OWNER_DATABASE_URL_FILE=
CONTINUUM_APP_DATABASE_URL_FILE=
# Approved identities: internal UUIDs distinct from external object IDs.
CONTINUUM_ADMIN_PRINCIPAL_ID=
CONTINUUM_ADMIN_ENTRA_OBJECT_ID=
CONTINUUM_ADMIN_DISPLAY_NAME=
CONTINUUM_SYNC_PRINCIPAL_ID=
CONTINUUM_SYNC_EXTERNAL_ID=
CONTINUUM_ENTRA_TENANT=
CONTINUUM_ENTRA_AUDIENCE=
CONTINUUM_ENTRA_USER_SCOPE=
CONTINUUM_ENTRA_SERVICE_APP_ROLE=
CONTINUUM_ENTRA_ALLOWED_CLIENT_IDS=
