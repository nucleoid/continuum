{
  "name": "@continuum/core",
  "version": "0.1.0",
  "description": "Vendor-agnostic memory layer for development teams",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "continuum-tags": "bin/continuum-tags.mjs",
    "continuum": "bin/continuum.mjs",
    "continuum-migrate": "bin/continuum-migrate.mjs"
  },
  "types": "dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/test-helpers.*",
    "!dist/**/*.map",
    "docs/agents-md-freshness.md",
    "docs/api-operations.md",
    "docs/authentication.md",
    "docs/remote-mcp.md",
    "docs/audit-api.md",
    "docs/audit-retention.md",
    "docs/cli.md",
    "docs/coordination.md",
    "docs/embedding-backfill.md",
    "docs/extensions.md",
    "docs/knowledge-gap-insights.md",
    "docs/lifecycle.md",
    "docs/offboarding.md",
    "docs/memory-api.md",
    "docs/scope-provisioning.md",
    "docs/tag-vocabularies.md",
    "docs/standup.md",
    "docs/webhook-ingestion.md",
    "!dist/**/tenants/**",
    "migrations",
    "scripts/ensure-scope.mjs",
    "scripts/*.sql",
    "README.md",
    "LICENSE",
    "deploy/container-entrypoint.mjs",
    "deploy/compose.production.yml",
    "deploy/production.env.example",
    "deploy/bootstrap-database.sql",
    "deploy/bootstrap-production-admin.sql",
    "deploy/apply-role-profiles.sh",
    "docs/deployment.md",
    "deploy/compose.uat.yml",
    "deploy/uat.env.example",
    "deploy/uat-proxy.conf.example",
    "docs/uat-deployment.md",
    "docs/uat-client-onboarding.md",
    "docs/delivery-forge-uat.md",
    "scripts/uat-mcp-smoke.mjs"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "prepack": "npm run clean && npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node dist/storage/migrate-cli.js",
    "migrate:dev": "tsx src/storage/migrate-cli.ts",
    "api": "node dist/api/server.js",
    "api:dev": "tsx src/api/server.ts",
    "mcp": "node dist/api/mcp.js",
    "mcp:dev": "tsx src/api/mcp.ts",
    "sweep": "node dist/lifecycle/sweep-cli.js",
    "sweep:dev": "tsx src/lifecycle/sweep-cli.ts",
    "audit-retention": "node dist/maintenance/audit-retention-cli.js",
    "audit-retention:dev": "tsx src/maintenance/audit-retention-cli.ts",
    "sync:memberships": "node dist/identity/sync-cli.js",
    "sync:memberships:dev": "tsx src/identity/sync-cli.ts",
    "admin": "node dist/identity/admin-cli.js",
    "admin:dev": "tsx src/identity/admin-cli.ts",
    "smoke:cli-package": "node scripts/cli-package-smoke.mjs",
    "tags": "node dist/cli/tag-vocabularies.js",
    "tags:dev": "tsx src/cli/tag-vocabularies.ts",
    "embed-backfill": "node dist/maintenance/embed-backfill-cli.js",
    "embed-backfill:dev": "tsx src/maintenance/embed-backfill-cli.ts",
    "test:container-entrypoint": "node --test deploy/container-entrypoint.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "pg": "^8.20.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
