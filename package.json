{
  "name": "@continuum/core",
  "version": "0.1.0",
  "description": "Vendor-agnostic memory layer for development teams",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "continuum": "bin/continuum.mjs",
    "continuum-migrate": "bin/continuum-migrate.mjs"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/test-helpers.*",
    "!dist/**/*.map",
    "docs/agents-md-freshness.md",
    "docs/api-operations.md",
    "docs/authentication.md",
    "docs/audit-api.md",
    "docs/audit-retention.md",
    "docs/cli.md",
    "docs/knowledge-gap-insights.md",
    "docs/lifecycle.md",
    "docs/offboarding.md",
    "docs/memory-api.md",
    "docs/scope-provisioning.md",
    "!dist/**/tenants/**",
    "migrations",
    "scripts/ensure-scope.mjs",
    "scripts/*.sql",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "prepack": "npm run clean && npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node dist/storage/migrate-cli.js",
    "migrate:dev": "tsx src/storage/migrate-cli.ts",
    "api": "node dist/api/server.js",
    "api:dev": "tsx src/api/server.ts",
    "mcp": "node dist/api/mcp.js",
    "mcp:dev": "tsx src/api/mcp.ts",
    "sweep": "node dist/lifecycle/sweep-cli.js",
    "sweep:dev": "tsx src/lifecycle/sweep-cli.ts",
    "audit-retention": "node dist/maintenance/audit-retention-cli.js",
    "audit-retention:dev": "tsx src/maintenance/audit-retention-cli.ts",
    "sync:memberships": "node dist/identity/sync-cli.js",
    "sync:memberships:dev": "tsx src/identity/sync-cli.ts",
    "admin": "node dist/identity/admin-cli.js",
    "admin:dev": "tsx src/identity/admin-cli.ts",
    "smoke:cli-package": "node scripts/cli-package-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "pg": "^8.20.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
